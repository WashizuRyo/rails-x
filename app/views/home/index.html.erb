<main>
  <h1>Rails X</h1>

  <% if user_signed_in? %>
    <p>ログイン中: <%= current_user.email %></p>
    <%= button_to "ログアウト", destroy_user_session_path, method: :delete %>
  <% else %>
    <p>X クローンへようこそ。</p>
    <nav aria-label="アカウント">
      <%= link_to "サインアップ", new_user_registration_path %>
      <%= link_to "ログイン", new_user_session_path %>
    </nav>
  <% end %>
</main>
